# Copy this file to .env and fill in the values.
# All environment variables for the entire monorepo live here.
#
# This file is for local development. In production the NEXT_PUBLIC_* values
# below come from GitHub *repository variables*: the release workflow passes
# them as build args and Next inlines them into the browser bundle, so the
# copies on the Coolify application do not reach the bundle at all. See
# docs/deployment.md.

# Android SDK path (for Expo development)
ANDROID_HOME=

# Prisma — PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/moventis-lleida"

# Google Maps JavaScript API key + Map ID (required for AdvancedMarker).
# This one Map ID must have both a light-mode and a dark-mode style *associated
# with it* in Google Cloud Console > Map Management — importing the style alone
# is not enough, and an unattached variant fails silently as Google's default
# basemap. The styles themselves are kept in map-styles/ (see its README).
# The app switches between them at runtime via the JS SDK's colorScheme option,
# not by loading a different Map ID.
NEXT_PUBLIC_MAPS_API_KEY=""
NEXT_PUBLIC_MAPS_MAP_ID=""

# Self-hosted Umami analytics — leave both empty to ship no tracker at all.
# `data-domains` on the script tag keeps local dev and previews out of the numbers.
NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://analytics.joeltaylor.business/script.js"
NEXT_PUBLIC_UMAMI_WEBSITE_ID="476b415f-19d4-4890-a764-155bd5d3c9c5"
