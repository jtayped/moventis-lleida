# Copy this file to .env and fill in the values.
# All environment variables for the entire monorepo live here.

# Android SDK path (for Expo development)
ANDROID_HOME=

# Prisma — PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/moventis-lleida"

# Google Maps JavaScript API key + Map ID (required for AdvancedMarker).
# This one Map ID should have both a light-mode and dark-mode style associated
# with it in Google Cloud Console > Map Management (see
# apps/web/src/styles/map-style-dark.json for the dark one) — the app switches
# between them at runtime via the JS SDK's colorScheme option, not by loading
# a different Map ID.
NEXT_PUBLIC_MAPS_API_KEY=""
NEXT_PUBLIC_MAPS_MAP_ID=""
