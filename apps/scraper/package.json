{
  "name": "@moventis/scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env watch src/index.ts",
    "start": "pnpm --filter=@moventis/db db:push --skip-generate && tsx src/index.ts",
    "sync": "tsx src/sync-once.ts",
    "sync:dev": "tsx --env-file=../../.env src/sync-once.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@moventis/db": "workspace:*",
    "@moventis/shared": "workspace:*",
    "node-cron": "^3.0.3",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@moventis/eslint-config": "workspace:*",
    "@moventis/tsconfig": "workspace:*",
    "@types/node": "^20.19.43",
    "@types/node-cron": "^3.0.11",
    "vitest": "^4.1.11"
  }
}
